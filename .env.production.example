# Docker compose interpolation.
ECHOLINE_DOMAIN=echoline.example.com
ECHOLINE_MEDIA_ROOT=/data/echoline/media

# If self-hosted Supabase Kong is published on the host at :8000, Caddy can expose it at /supabase.
SUPABASE_KONG_URL=http://host.docker.internal:8000

# App runtime.
NEXT_PUBLIC_SUPABASE_URL=https://echoline.example.com/supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-self-hosted-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-self-hosted-supabase-service-role-key

# Admin video uploads and playback use the server media directory.
MEDIA_STORAGE=local
LOCAL_MEDIA_ROOT=/data/echoline/media
MEDIA_BUCKET=media
RECORDINGS_BUCKET=recordings

# Redis is provisioned for cache/queue work; V1 can run without app-level Redis calls.
REDIS_URL=redis://redis:6379/0

# Optional ASR provider for uploaded recordings.
ASR_PROVIDER=openai
OPENAI_API_KEY=
ASR_MODEL=gpt-4o-mini-transcribe
# OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1/audio/transcriptions

# Optional low-level endpoint override for dictionary AI development/debugging only.
# DICTIONARY_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
