# Docker compose interpolation.
ECHOLINE_DOMAIN=echoline.example.com
ECHOLINE_MEDIA_ROOT=/data/echoline/media

# PostgreSQL.
POSTGRES_DB=echoline
POSTGRES_USER=echoline
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgres://echoline:replace-with-strong-password@postgres:5432/echoline

# Auth.js.
NEXTAUTH_URL=https://echoline.example.com
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Linux.do OAuth.
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=

# Admin video uploads, playback, and recordings use the server media directory.
LOCAL_MEDIA_ROOT=/data/echoline/media

# Redis is provisioned for cache/queue work; V1 can run without app-level Redis calls.
REDIS_URL=redis://redis:6379/0

# Optional ASR provider for uploaded recordings.
ASR_PROVIDER=openai
OPENAI_API_KEY=
ASR_MODEL=gpt-4o-mini-transcribe
# OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1/audio/transcriptions

# Optional low-level endpoint override for dictionary AI development/debugging only.
# DICTIONARY_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
