NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: private Supabase Storage bucket for repeat/call-response recordings.
RECORDINGS_BUCKET=recordings

# Optional: ASR provider for uploaded recordings.
ASR_PROVIDER=openai
OPENAI_API_KEY=
ASR_MODEL=gpt-4o-mini-transcribe
# OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1/audio/transcriptions

# Optional: Chinese in-context dictionary fallback.
# Provider defaults to bigmodel. Use "siliconflow" for SiliconFlow's OpenAI-compatible endpoint.
DICTIONARY_AI_PROVIDER=bigmodel
DICTIONARY_AI_API_KEY=
DICTIONARY_AI_MODEL=glm-4-flash
# DICTIONARY_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
