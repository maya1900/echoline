NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: private Supabase Storage bucket for repeat/call-response recordings.
RECORDINGS_BUCKET=recordings

# Optional: private Supabase Storage bucket for episode media.
MEDIA_BUCKET=media

# Optional: admin upload backend for episode videos.
# Use local for self-hosted Docker deployments, or supabase for Supabase Storage.
MEDIA_STORAGE=local

# Optional: local media directory for self-hosted Docker deployments.
# episodes.media_url can use local/path/to/video.mp4, resolved under this root.
LOCAL_MEDIA_ROOT=./media

# Optional: ASR provider for uploaded recordings.
ASR_PROVIDER=openai
OPENAI_API_KEY=
ASR_MODEL=gpt-4o-mini-transcribe
# OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1/audio/transcriptions

# Chinese in-context dictionary fallback is configured in /admin.
# Optional low-level endpoint override for development/debugging only.
# DICTIONARY_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
