DATABASE_URL=postgres://echoline:echoline@localhost:5432/echoline

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=

# Local private media directory. episodes.media_url can use local/path/to/video.mp4.
LOCAL_MEDIA_ROOT=./media

# Optional ASR provider for uploaded recordings.
ASR_PROVIDER=openai
OPENAI_API_KEY=
ASR_MODEL=gpt-4o-mini-transcribe
# OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1/audio/transcriptions

# Chinese in-context dictionary fallback is configured in /admin.
# Optional low-level endpoint override for development/debugging only.
# DICTIONARY_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
